# Control de Mantenimiento / Frontend
VITE_MAINTENANCE_MODE=false
VITE_API_URL=http://localhost:3001

# Panel Administrativo - Pruebas Locales
# Si es true, la pantalla /admin/contactos usa datos simulados (mock).
# Si es false o no está definida, consulta la base de datos MySQL real vía PHP API.
VITE_USE_MOCK_LEADS=false

# Configuración del Servidor de Correo para G-Calls
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_clave_de_aplicacion_aqui

# Base de Datos MySQL — PHP API (public/api/)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gcalls_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
