# Copia este archivo como .env en la raíz del proyecto (nunca lo subas al repositorio).

# --- Frontend (Vite) ----------------------------------------------------------
# Pantalla de mantenimiento en producción: activa salvo que valga "false".
# En desarrollo (npm run dev) nunca se muestra.
VITE_MAINTENANCE_MODE=false

# Panel administrativo - pruebas locales
# Si es true, /admin/contactos usa datos simulados (mock).
# Si es false o no está definida, consulta la base de datos MySQL real vía la API PHP.
VITE_USE_MOCK_LEADS=false

# --- Base de datos MySQL (API PHP en public/api/) ------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gcalls_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Imágenes subidas desde el panel ------------------------------------------
# Carpeta donde se guardan. Por defecto: <raíz del proyecto>/storage/medios, que en el
# hosting queda fuera de public_html. Solo cámbiala si el hosting exige otra ruta.
# MEDIOS_DIR=

# --- Correo SMTP (pendiente: notificación de leads desde PHP, hito H4) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
